# Copy to .env for local overrides. These values are for local development only.

# Local Postgres (docker compose up -d)
POSTGRES_USER=pvp
POSTGRES_PASSWORD=pvp_dev_only
POSTGRES_DB=pvp
POSTGRES_PORT=5432
DATABASE_URL=postgres://pvp:pvp_dev_only@localhost:5432/pvp

# Game server
PORT=3001
# Signs guest device tokens. Required in production; use a long random value there.
GUEST_TOKEN_SECRET=local-dev-secret-change-me
